{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "playwright-orchestrator-workspace",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "type-check": "turbo run type-check",
    "typecheck": "bun run type-check",
    "test": "turbo run test --filter=@nsxbet/*",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "0.5.2",
    "@changesets/cli": "2.29.8",
    "@types/node": "22.15.29",
    "lefthook": "2.0.14",
    "lint-staged": "16.2.6",
    "oxfmt": "0.35.0",
    "oxlint": "1.41.0",
    "turbo": "2.8.3",
    "typescript": "5.9.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,tsx}": "oxlint --fix",
    "*.{json,jsonc,yml,yaml,md,css}": "oxfmt --write"
  },
  "packageManager": "bun@1.3.6"
}
